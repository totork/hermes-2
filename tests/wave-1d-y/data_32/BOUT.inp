#
# Input file for 1D wave MMS test
#

nout =100      # Number of output timesteps
timestep = 0.1  #Time between outputs


MXG = 2
MYG = 2

#grid = "MMS_straight_slab.fci.grid.nc"
grid = "MMS_straight_slab_32.fci.grid.nc"

this_y = y / (2*pi)

[mesh:paralleltransform]
type = fci


[input]
error_on_unused_options=false


[mesh]

symmetricGlobalX = true

extrapolate_y = false

##################################################
[mesh:ddx]   # Methods used for perp (x) derivative terms

first = C2
second = C2
upwind = U1
flux = SPLIT

[mesh:ddy]   # Methods used for parallel (y) derivative terms

first = C2
second = C2
upwind = U1
flux = SPLIT

[mesh:ddz]   # Methods used for perp (z) derivative terms

first = C2
second = C2
upwind = U1
flux = SPLIT

[solver]

mms = true

atol = 1e-15 # absolute tolerance
rtol = 1e-10  # relative tolerance
mxstep = 10000000

[f]
qq=y/(2.0*pi)
solution = f:qq - sin(100.0*t)*cos(0.5*f:qq) + cos(f:qq)
ddy = 0.5*sin(t)*sin(0.5*f:qq) - sin(f:qq) + 1
source = 0.2*f:qq*sin(0.1*f:qq^2)*cos(t) - 2*f:qq - cos(t)*cos(0.5*f:qq) - cos(f:qq)

bndry_all = neumann_o2(f:ddy)
bndry_par_all = parallel_dirichlet_o2(f:solution)

[g]
solution = f:qq^2 + sin(f:qq) + cos(t)*cos(0.1*f:qq^2)
# ddy = -0.2*f:qq*sin(0.1*f:qq^2)*cos(t) + 2*f:qq + cos(f:qq)
source = -0.5*sin(t)*sin(0.5*f:qq) - sin(t)*cos(0.1*f:qq^2) + sin(f:qq) - 1

bndry_all = dirichlet_o2(g:solution)
bndry_par_all = parallel_dirichlet_o2(g:solution)
