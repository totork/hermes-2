#
# Input file for 1D wave MMS test
#

nout =100      # Number of output timesteps
timestep = 0.1  #Time between outputs


MXG = 2
MYG = 2

grid = "cor_MMS_straight_slab_96_96_96.fci.grid.nc"



Dx = 1.0
Dy = 1.0
Dz = 1.0

[mesh:paralleltransform]
type = fci


[input]
error_on_unused_options=false


[mesh]

symmetricGlobalX = true

extrapolate_y = false

##################################################
[mesh:ddx]   # Methods used for perp (x) derivative terms

first = C2
second = C2
upwind = U1
flux = SPLIT

[mesh:ddy]   # Methods used for parallel (y) derivative terms

first = C2
second = C2
upwind = U1
flux = SPLIT

[mesh:ddz]   # Methods used for perp (z) derivative terms

first = C2
second = C2
upwind = U1
flux = SPLIT

[solver]

mms = true
mms_initialise = true
atol = 1e-15 # absolute tolerance
rtol = 1e-10  # relative tolerance
mxstep = 10000000

[N]

xl = x*2*pi           # In the range [0,Lx]
yl = y/(2*pi)  	      # In the range [0,Ly]
zl = z


#solution = 0.9*N:yl + 0.2*sin(5.0*N:yl^2 - 2*z) + sin(7*N:xl + 1.234)*cos(N:xl)*cos(10*z) + 0.9			#XYZ
solution = 0.9 + 0.9*yl + 0.2*cos(10*t)*sin(5.0 * yl^2)
#solution = 0.9 + 0.9*yl + 0.2*sin(5.0*yl^2)


source = -2.*sin(10*t)*sin(5.*yl^2) + cos(10*t)*(-2.*cos(5.*yl^2) + 20.*(yl)^2 * sin(5.*yl^2))


#source = 20.0*N:yl^2*sin(5.0*N:yl^2 - 2*z) + 2.0*(7*sin(N:xl)*cos(7*N:xl + 1.234) + 25*sin(7*N:xl + 1.234)*cos(N:xl))*cos(10*z) + 0.8*sin(5.0*N:yl^2 - 2*z) + 100.0*sin(7*N:xl + 1.234)*cos(N:xl)*cos(10*z) - 2.0*cos(5.0*N:yl^2 - 2*z)

#source = 20.0 * yl^2 * sin(5.0*yl^2) - 2.0 * cos(5.0* yl^2 )

bndry_all = dirichlet_o2(N:solution)
