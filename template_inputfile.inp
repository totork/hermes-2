
nout = 10
timestep = 1e-10


TwistShift = false  # use twist-shift condition?
ballooning = false  # ballooning transformation?
shiftinitial = false
ShiftWithoutTwist=false

MYG=2
MXG=2

grid = "cor_islanddivertor_260_4_1024_6.0_1.0_0.8_0.4_0.1_0.875_0.0_0.0_0.0.fci.grid.nc"

dump_format = nc

[mesh]
symmetricGlobalX = true

extrapolate_y = false   # Extrapolate metrics into Y boundary cells?

[mesh:paralleltransform]
type = fci

[input]
error_on_unused_options=false

[restart_files]
init_missing = true # initialize missing variables on restart?

##################################################
# derivative methods

[ddx]

first = C2
second = C2
upwind = W3

[ddy]

first = C2
second = C2
upwind = W3

[ddz]

first = C2
second = C2
upwind = W3

###################################################
# Time-integration solver

[solver]


# Note: If evolving neutrals, need preconditioning
type = cvode
#use_precon = true

atol = 1.0e-12  # absolute tolerance
rtol = 1.0e-8   # relative tolerance
mxstep = 1000000  # Maximum internal steps per output

cvode_max_order = 2
cvode_stability_limit_detection = true


########################################################################################

[phiSolver]

type   = petsc  # Needed if Boussinesq = false

ksptype = gmres # Linear iterative method

pctype = hypre # Preconditioner. Direct "lu" or "ilu"; iterative "jacobi", "sor"

atol=1e-12
rtol = 1e-8
# Set package to perform factorisation for direct solves
# "petsc" built-in solver only serial
# "superlu", "superlu_dist", "mumps", "cusparse"
factor_package = superlu_dist

inner_boundary_flags = 2
outer_boundary_flags = 16

all_terms = false
nonuniform = true   # NOTE: Necessary to avoid numerical instability

#########################################################################################

[aparSolver]
type = petsc

rtol=1e-8
atol=1e-12

# ksptype = gmres   # Linear iterative method

# pctype  = hypre   # Preconditioner. Direct "lu" or "ilu"; iterative "jacobi", "sor"

# # Set package to perform factorisation for direct solves
# # "petsc" built-in solver only serial
# # "superlu", "superlu_dist", "mumps", "cusparse"
# factor_package = superlu_dist


inner_boundary_flags = 0
outer_boundary_flags = 0

# all_terms = true
# nonuniform = true

# general settings for the model
[input]

transform_from_field_aligned=False


[Hermes]

electromagnetic = false
j_pol_pi = false
j_pol_simplified = true
boussinesq = true
FiniteElMass = true

evolve_ne = true
evolve_nvi = true
evolve_te = true
evolve_ti = true
evolve_vort = true
evolve_vepsi = true


verbose = true
output_ddt = false

Tnorm = 20
Nnorm = 1e19
Bnorm = 1.0
AA = 2.0


[Transportcoefficients]


anomalous_D = 0.1
anomalous_nu = 0.1
anomalous_chi = 0.1


[Numerics]

use_Div_n_bxGrad_f_B_XPPM = false
use_bracket = true

ne_bndry_flux = false
pe_bndry_flux = false
vort_bndry_flux = false

flux_limit_alpha = -1
kappa_limit_alpha = -1
eta_limit_alpha = -1

resistivity_multiply = 1.0
electron_weight = 1.0


[Sheath]

sheath_model = 0
sheath_gamma_e = 6.0
sheath_gamma_i = 3.5

parallel_sheaths = 0.0
sheath_allow_supersonic = true


########################################################################################
########################################################################################
########################################################################################
########################################################################################
########################################################################################

[all]
scale = 1.0

bndry_all = neumann_o2
bndry_xin = neumann_o2
bndry_xout =neumann_o2
bndry_par_all = parallel_neumann_o2

########################################################################################


[Ne] # Electron density
scale = 1
function = 2.0 - x
source = 3e2*gauss(x, 0.24)


#Switches for terms

Ne_ExB = false
Ne_mag = false
Ne_parflow = false
Ne_collision = false
Ne_anomalous = false
Ne_sources = false
Ne_hyper = false
Ne_numdiff = false


########################################################################################


[NVi]

scale = 1
function = 0.0

#Switches for terms

NVi_ExB = false
NVi_mag = false
NVi_parflow = false
NVi_parpressure = false
NVi_parviscos = false
NVi_collision = false
NVi_anomalous = false
NVi_hyper = false
NVi_numdiff = false


########################################################################################


[Pe]  # Electron pressure
scale = 1
function = Ne:function + (2.0-x)*Ne:function
source = 5.0*Ne:source


#Switches for terms

Pe_ExB = false
Pe_mag = false
Pe_parflow = false
Pe_conduction = false
Pe_ohmic = false
Pe_thermalforce = false
Pe_thermalcurrent = false
Pe_collision = false
Pe_anomalous = false
Pe_sources = false
Pe_energyexchange = false
Pe_hyper = false
Pe_numdiff = false


####################################################################################


[Pi]
scale = 1
function = Pe:function
source = Pe:source


#Switches for terms

Pi_ExB = false
Pi_mag = false
Pi_parflow = false
Pi_conduction = false
Pi_diamagenergyexchange = false
Pi_parviscousheat = false
Pi_resistivedrift = false
Pi_perpviscous = false
Pi_sources = false
Pi_hyper = false
Pi_numdiff = false
Pi_anomalous = false
Pi_energyexchange = false

####################################################################################


[Vort]
scale=1.0
function=1e-4*sin(14*pi*x)*sin(8*z)*gauss(x,0.4)


#Switches for terms

Vort_mag = false
Vort_parcurrent = false
Vort_polarcurrent = false
Vort_collision = false
Vort_parviscous = false
Vort_anomalous = false
Vort_hyper = false
Vort_numdiff = false

########################################################################################


[VePsi] # Ve + 0.5*beta_e*mi_me*psi
scale = 1
bndry_xin = neumann_o2
function = 0.0

#Switches for terms

VePsi_parefield = false
VePsi_parpressure = false
VePsi_partemp = false
VePsi_parcurrent = false
VePsi_ExB = false
VePsi_parflow = false
VePsi_hyper = false
VePsi_numdiff = false
