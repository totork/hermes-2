Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"SAVE", " ", "AUXILIARY", " ", "VARIABLES"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dataAUX", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Omegadenom\>\"", "->", "Omegadenom"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<resistivity_multiply\>\"", "->", "resistivitymultiply"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"\"\<electromagnetic\>\"", "->", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"SWelectromagnetic", "==", "1.0"}], ",", "\"\<true\>\"", 
         ",", "\"\<false\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<j_pol_pi\>\"", "->", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"SWjpolpi", "==", "1.0"}], ",", "\"\<true\>\"", 
         ",", "\"\<false\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<calc_potential\>\"", "->", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"SWcalcpotential", "==", "1.0"}], ",", "\"\<true\>\"", 
         ",", "\"\<false\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<presetmode\>\"", "->", "presetmode"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<steady_state\>\"", "->", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"SWsteadystate", "==", "1.0"}], ",", "\"\<true\>\"", 
         ",", "\"\<false\>\""}], "]"}]}]}], "|>"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"\"\<AUX.json\>\"", ",", "dataAUX"}], "]"}], ";"}]}]}]], "Input",\

